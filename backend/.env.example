PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/github-rag

# ChromaDB
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Repository storage
REPOS_DIR=./data/repos

# CORS
FRONTEND_URL=http://localhost:3000

# Auth (single demo user - see README "Authentication" section)
# AUTH_PASSWORD_HASH is a bcrypt hash, never a plaintext password.
# Generate it with: npm run hash-password -- "your-chosen-password"
AUTH_EMAIL=demo@example.com
AUTH_PASSWORD_HASH=replace_with_output_of_npm_run_hash-password
# Long random string, e.g.: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string