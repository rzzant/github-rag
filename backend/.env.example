PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/github-rag

# ChromaDB
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
